<launch>
<!-- Launch file for Livox Mid360 LiDAR -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find kilvo)/config/mid360_d455.yaml" />

	<node pkg="kilvo" type="kilvo" name="laserMapping" output="screen">
		<rosparam file="$(find kilvo)/config/camera_d455_pinhole.yaml" />
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find kilvo)/rviz_cfg/kilvo.rviz" />
	</group>

	<node name="plotter" pkg="kilvo" type="plot_rt.py" output="screen" />

launch-prefix="gdb -ex run --args"
launch-prefix="valgrind --leak-check=full"
</launch> 	
